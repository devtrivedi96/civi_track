rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper to read the requestor's department from their profile
    function getUserDepartment() {
      return get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.department;
    }

    match /profiles/{userId} {
      // ✅ Allow owner to read their own doc
      // ✅ Allow admins to read/list all docs
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin(); 

      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /reports/{reportId} {
      // Public read allowed so guests can browse reports
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isOwner(request.resource.data.userId) || isAdmin() || (
        isAuthenticated() && 
        exists(/databases/$(database)/documents/profiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'official' &&
        (
          resource.data.department == get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.department ||
          resource.data.department == 'Public Works' && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.department == 'publicworks' ||
          resource.data.department == 'Water Department' && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.department == 'waterdepartment' ||
          resource.data.department == 'Electricity Board' && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.department == 'electricityboard' ||
          resource.data.department == 'Sanitation' && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.department == 'sanitation' ||
          resource.data.department == 'Law Enforcement' && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.department == 'lawenforcement' ||
          resource.data.department == 'Health Department' && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.department == 'healthdepartment' ||
          resource.data.department == 'Education Department' && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.department == 'educationdepartment' ||
          resource.data.department == 'Environmental Protection' && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.department == 'environmentalprotection' ||
          resource.data.department == 'Transport Department' && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.department == 'transportdepartment' ||
          resource.data.department == 'Parks Department' && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.department == 'parksdepartment'
        )
      );
      allow delete: if isAdmin();
    }

    match /report_comments/{commentId} {
      // Allow guests to read report comments
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // CamelCase variant used by client
    match /reportComments/{commentId} {
      // Allow guests to read report comments (camelCase collection)
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    match /status_history/{historyId} {
      // Allow guests to read status history entries
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // 🔥 Manage Officials
    match /officials/{officialId} {
      // Allow guests to read officials for assignment lookups
      allow read: if true;
      // Only admins can write
      allow create, update, delete: if isAdmin();
    }

    // Support camelCase collection used by client code
    match /statusHistory/{historyId} {
      // Allow guests to read status history entries (camelCase)
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Gamification collections
    match /user_progress/{userId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /achievements/{achievementId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /leaderboard/{entryId} {
      allow read: if isAuthenticated();
      allow create, update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Department-mirrored reports for easier queries
    match /department_reports/{department} {
      // Allow guests to read department mirrored reports
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
      
      // Subcollections under department
      match /reports/{reportId} {
        // Allow guests to read department reports
        allow read: if true;
        allow create: if isAuthenticated();
        allow update: if isAuthenticated();
        allow delete: if isAdmin();
      }
    }
  }
}
