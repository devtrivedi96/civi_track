    "firebase": "^12.3.0",
    "framer-motion": "^11.3.28",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.63.0",
    "react-image-file-resizer": "^0.4.8",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.9.1",
    "tailwind-variants": "^0.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/leaflet": "^1.9.20",
