{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview --host --port $PORT",
    "setup-officials": "tsx src/setup/initialize.ts",
    "start:client": "npm run preview",
    "start:server": "cd server && node index.js",
    "start:all": "npm-run-all --parallel start:client start:server",
    "postinstall": "npm run build && cd server && npm install --legacy-peer-deps",
    "setup": "npm install --legacy-peer-deps && cd server && npm install --legacy-peer-deps"
  },
  "dependencies": {
    "@google-cloud/vision": "^5.3.3",
    "date-fns": "^4.1.0",
    "exif-js": "^2.3.0",
    "firebase": "^12.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.63.0",
    "react-image-file-resizer": "^0.4.8",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/leaflet": "^1.9.20",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "dotenv": "^17.2.2",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.20.5",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
